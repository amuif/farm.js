{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- ':/docs' ':/packages/farm' ':/packages/farm-cli' ':/packages/farm-devtools' ':/pnpm-lock.yaml' ':(exclude,top,glob)**/__tests__/**'"
}
